# Copy to .env.local and fill in.

# Supabase project (Project Settings > API). The anon/publishable key is safe
# to expose; row-level security in the database does the access control.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used for AI drafts and weekly reviews.
ANTHROPIC_API_KEY=

# Timezone used to decide what "this week" is. Any IANA name; defaults to UTC.
CLINIC_TIMEZONE=America/Toronto
